{
  "name": "@aei/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm.cmd --workspace @aei/shared run build",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "presmoke:auth": "npm.cmd --workspace @aei/shared run build",
    "smoke:auth": "tsx src/smoke/openaiAuthSmoke.ts",
    "presmoke:dashboard-auth": "npm.cmd --workspace @aei/shared run build",
    "smoke:dashboard-auth": "tsx src/smoke/dashboardAuthSmoke.ts",
    "presmoke:csv-export": "npm.cmd --workspace @aei/shared run build",
    "smoke:csv-export": "tsx src/smoke/csvExportSmoke.ts",
    "presmoke:logging-reliability": "npm.cmd --workspace @aei/shared run build",
    "smoke:logging-reliability": "tsx src/smoke/openaiLoggingReliabilitySmoke.ts",
    "presmoke:usage": "npm.cmd --workspace @aei/shared run build",
    "smoke:usage": "tsx src/smoke/openaiUsageExtractionSmoke.ts",
    "presmoke:summary": "npm.cmd --workspace @aei/shared run build",
    "smoke:summary": "tsx src/smoke/summaryApiSmoke.ts",
    "smoke:demo": "tsx src/smoke/openaiDemoSmoke.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aei/shared": "0.1.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
