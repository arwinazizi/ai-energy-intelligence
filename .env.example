# Backend
PORT=4000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Client API keys are stored as SHA-256 hashes in public.api_keys.key_hash.
# Send the raw client key with the x-api-key request header.

# Local AEI-009 live demo smoke script
AEI_CLIENT_API_KEY=
AEI_API_BASE_URL=http://127.0.0.1:4000
AEI_DEMO_MODEL=gpt-4.1-mini

# Dashboard local/pilot configuration
DASHBOARD_PILOT_USERNAME=
DASHBOARD_PILOT_PASSWORD=
DASHBOARD_PILOT_PASSWORD_SHA256=
DASHBOARD_SESSION_SECRET=
DASHBOARD_CORS_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_AEI_CLIENT_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
